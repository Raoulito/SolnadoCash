# SolnadoCash frontend configuration
#
# Copy to .env.local and adjust. All values are optional; the defaults target
# devnet with a relayer on localhost, which is fine for development and NOT fine
# for a public deployment.

# devnet | testnet | mainnet-beta
VITE_SOLANA_NETWORK=devnet

# RPC endpoint. The default public endpoint prunes transaction history and
# rate-limits aggressively, which breaks Merkle tree reconstruction for older
# deposits (see SECURITY-REVIEW.md H-5). Use an archival provider.
VITE_RPC_ENDPOINT=https://api.devnet.solana.com

# Relayer base URL. MUST be https:// for any real deployment: the relayer receives
# the recipient address and nullifier along with the user's IP, and the app shows a
# warning when this is plaintext HTTP from a non-local origin.
VITE_RELAYER_URL=http://localhost:3000

# Deployed program ID
VITE_PROGRAM_ID=DMAPWBXb5w2KZkML2SyV2CtZDfbwNKqkWL3scQKXUF59

{
  "name": "@sornadocash/app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:sdk": "cd ../sdk && npm run build",
    "dev": "npm run build:sdk && vite",
    "build": "npm run build:sdk && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "npm run build:sdk && tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "test:security": "vitest run --config vitest.security.config.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-phantom": "^0.9.24",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "@solana/wallet-adapter-solflare": "^0.6.28",
    "@solana/web3.js": "^1.98.0",
    "@solnadocash/sdk": "file:../sdk",
    "circomlibjs": "^0.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "snarkjs": "^0.7.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.49.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^5.4.11",
    "vite-plugin-node-polyfills": "^0.22.0",
    "vitest": "^2.1.9"
  }
}
# ── Build artifacts ──────────────────────────────────────────────────────────
target/
dist/

# ── Node dependencies ────────────────────────────────────────────────────────
node_modules/

# ── Anchor local test ledger ─────────────────────────────────────────────────
.anchor/

# ── ZK circuit build artifacts (large binaries, regenerable) ─────────────────
# Exclude the CONTENTS, not the directory itself: git cannot re-include a file whose
# parent directory is excluded, so "circuits/build/" would defeat the negation below.
circuits/build/*
# …but the verifying key must be committed: the relayer needs it to validate proofs
# off-chain, and third parties need it to check that programs/…/vk.rs corresponds to
# the circuit (M-7). It is ~3 KB of public data, not a secret.
!circuits/build/withdraw_vk.json

# ── Project documentation (private) ──────────────────────────────────────────
CLAUDE.md
PROJET_enhanced.md
PROJET.md
TASKS.md

# ── Environment and secrets ──────────────────────────────────────────────────
.env
.env.*
# …but keep the documented templates
!.env.example
!**/.env.example
*.pem
*.key

# ── Claude Code local settings ──────────────────────────────────────────────
.claude/

# ── OS and IDE ───────────────────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*

# ── TypeScript build info ────────────────────────────────────────────────────
*.tsbuildinfo

# ── Temporary files ──────────────────────────────────────────────────────────
tmp/
temp/
scripts/verify_devnet.*
.devnet_verify_leaves.json
proptest-regressions/

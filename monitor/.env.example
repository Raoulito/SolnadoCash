# SolnadoCash monitor configuration
#
# Copy to .env and fill in. Load it however you prefer — the systemd unit in this
# directory uses EnvironmentFile.
#
# ── Deploying on an Ubuntu VM (e.g. Oracle Cloud free tier) ──────────────────
#   sudo apt install -y nodejs npm
#   git clone <repo> && cd SolnadoCash/monitor && npm install --omit=dev
#   cp .env.example .env && $EDITOR .env
#   # try it once, then install as a service:
#   npm run once
#   sudo cp solnadocash-monitor.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now solnadocash-monitor
#   journalctl -u solnadocash-monitor -f
#
# Prefer running it on the same box as the relayer: that machine already has to be up
# 24/7 or withdrawals cannot be relayed, so it needs watching anyway.

# ── required ────────────────────────────────────────────────────────────────
# Comma-separated pool addresses. Must match app/src/config.ts.
POOLS=FWQkYzmNz74VSffemu9tphYX1TSSfTBo9JYgKRWRWcoY,2MgQTtJGed9eR9itPk9nUChYbvCTpfmNhKTxpnUA2S3d,GhbShsZipzgpRxZSihAkn1Bmstzoq9CgpDrbGXz3bNFE,F5Qkfpw57KCXB8uXam1p3wAkf5YazSURPJWb1WVqfs7n

# ── strongly recommended ────────────────────────────────────────────────────
# Without this the monitor CANNOT detect a key takeover, which is the single most
# damaging event it could catch: whoever holds this key can redeploy the program and
# drain every vault. Set it to the current authority and it will alert if that changes.
EXPECTED_UPGRADE_AUTHORITY=UPGR5rk6RR9Ry9WhLdQJS2xnDCdeHwwjfA4K1CiGKxp

# ── alerting ────────────────────────────────────────────────────────────────
# Create a bot with @BotFather, then message it once and read your chat id from
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# With these unset the monitor still runs and logs to the console/journal.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── optional ────────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=DMAPWBXb5w2KZkML2SyV2CtZDfbwNKqkWL3scQKXUF59

# Relayer wallet. Below ~0.01 SOL it cannot pay nullifier rent and NO withdrawal can be
# relayed, which pushes users into self-relaying and destroys their privacy.
RELAYER_PUBKEY=RELAqsWHQuMLSYj62qkbyRgQtSo1jBQ5cTsBu9j96MD

# Seconds between passes. 60 is ample: total outflow is already capped at total deposits
# by the on-chain vault-balance guard, so this is early warning, not a race.
INTERVAL_SECONDS=60

# Where per-pool baselines and alert timestamps persist across restarts.
STATE_PATH=./state.json

# WARNING/INFO alerts are suppressed for this long per (code, pool) so a persistent
# condition does not become a flood you learn to ignore. CRITICAL always alerts.
ALERT_COOLDOWN_MINUTES=30
